# Preferred on Vercel. This is read server-side and passed to the map client.
MAPBOX_ACCESS_TOKEN=

# Optional fallback if you prefer a browser-exposed public env var.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Required for collaborative production persistence.
# Without these, the map falls back to browser-only local demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
